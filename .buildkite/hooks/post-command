#!/usr/bin/env bash
# Gives this job's nextest JUnit report (.config/nextest.toml's ci profile) a
# name unique to the job, so the test-engine and test-timings steps can
# collect every job's without them overwriting each other. The name carries
# the OS, which test-plan.py keeps timings per. post-command runs whether or
# not the command passed, and before the step's artifact_paths are uploaded.
set -euo pipefail

if [ -f test-results/junit.xml ]; then
  case "$(uname -s)" in
    Darwin) os=macos ;;
    *) os=linux ;;
  esac
  mv test-results/junit.xml "test-results/junit-${os}-${BUILDKITE_JOB_ID}.xml"
fi
