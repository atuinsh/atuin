env-ignored-path = ignoring { $name }: { $error }
mcp-server-added = Added MCP server atuin to { $path }
mcp-server-removed = Removed MCP server atuin from { $path }
hermes-plugin-enable-failed = Could not enable the Hermes plugin ({ $error }). Run `{ $command }` to turn it on.
hermes-plugin-remove-failed = Could not remove the Hermes plugin through Hermes ({ $error }), so its config may still list it. Run `{ $command }` to tidy it up.
