# Sourced by every demo first: the window. A demo can change it before it
# sources start.tape, as betamax ignores a Set once the tape has run anything.
# Colors come from themes/, and outputs from demos/render.sh, which renders
# each demo once per theme.
Set Shell "zsh"
Set Width 1500
Set Height 720
# IBM Plex Mono with the symbols agents draw (fonts/build.py).
Set FontFamily "Atuin Demo Mono"
Set FontSize 25
Set LetterSpacing 0
Set LineHeight 1.25
Set Padding 28
Set CursorBlink false

Set WindowBar "Colorful"
Set WindowBarSize 48
Set WindowTitleFromTerminal false
Set BorderRadius 16
Set WindowBorder 1
Set Margin 48
Set MarginFill "transparent"
Set Shadow true
Set ShadowBlur 32
Set ShadowOffset 12

